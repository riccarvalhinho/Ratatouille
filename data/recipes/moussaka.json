  "steps": [
    {
      "title": "Salgar e escorrer a beringela",
      "text": "Fatias salgadas em camadas num escorredor, meia hora, depois secas com pano.",
      "durationMinutes": 35,
      "passive": true,
      "ingredientRefs": [
        "beringela",
        "sal"
      ]
    },
    {
      "title": "Assar a beringela",
      "text": "Fatias pinceladas com azeite no tabuleiro, a 200 graus, viradas a meio, até dourarem.",
      "durationMinutes": 25,
      "temperatureC": 200,
      "passive": true,
      "ingredientRefs": [
        "azeite"
      ]
    },
    {
      "title": "Apurar a carne",
      "text": "Cebola e alho no azeite, carne a tostar, vinho tinto a evaporar, tomate pelado, canela e orégãos. Vinte minutos.",
      "durationMinutes": 25,
      "ingredientRefs": [
        "cebola",
        "dente-de-alho",
        "carne-picada-de-vaca",
        "vinho-tinto",
