  "steps": [
    {
      "text": "Escorra e passe o grão por água fria, para tirar o sabor a conserva.",
      "ingredientRefs": [
        "grao-de-bico-cozido"
      ]
    },
    {
      "text": "Deixe a cebola roxa cinco minutos em água fria, para perder o picante.",
