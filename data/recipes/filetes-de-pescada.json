        "dente-de-alho",
        "limao"
      ]
    },
    {
      "title": "Fazer o arroz de tomate",
      "text": "Cebola e alho no azeite, tomate ralado cinco minutos a desfazer, depois o arroz e a água a ferver com sal. Tapado, 18 minutos.",
      "durationMinutes": 25,
      "ingredientRefs": [
        "cebola",
        "azeite",
        "tomate",
        "arroz-carolino",
        "agua"
      ]
    },
    {
      "title": "Preparar o polme",
      "text": "Farinha, ovos e cerveja mexidos só até ligar, com uma pitada de sal.",
      "durationMinutes": 5,
      "ingredientRefs": [
        "farinha-de-trigo",
        "ovo",
        "cerveja"
      ]
    },
    {
      "title": "Fritar os filetes",
      "text": "Passar pelo polme e fritar em óleo bem quente, três ou quatro de cada vez, dourados dos dois lados. Escorrer em papel.",
