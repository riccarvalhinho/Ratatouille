  "steps": [
    {
      "title": "Temperar os filetes",
      "text": "Sal, pimenta, alho esmagado e sumo de limão sobre o peixe. Deixar enquanto se faz o arroz.",
      "durationMinutes": 8,
      "ingredientRefs": [
        "pescada",
