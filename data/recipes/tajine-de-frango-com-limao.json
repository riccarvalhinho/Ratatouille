  "steps": [
    {
      "title": "Alourar o frango",
      "text": "Coxas temperadas em azeite quente, até corarem de todos os lados. Retirar.",
      "durationMinutes": 12,
      "ingredientRefs": [
        "coxa-de-frango",
        "azeite",
        "sal",
        "pimenta-preta"
      ]
    },
    {
      "title": "Tostar as especiarias",
      "text": "Cebola, alho e gengibre a amolecer, depois curcuma, cominhos, canela e açafrão um minuto no fundo.",
      "durationMinutes": 10,
      "ingredientRefs": [
