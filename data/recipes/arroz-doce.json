  "steps": [
    {
      "text": "Leve o arroz ao lume com a água, a casca de limão, o pau de canela e a pitada de sal.",
      "ingredientRefs": [
        "arroz-carolino",
        "agua",
        "limao",
        "pau-de-canela",
        "sal"
      ]
    },
    {
      "text": "Deixe cozer em lume brando até a água estar quase toda absorvida.",
      "durationMinutes": 12,
      "ingredientRefs": [
        "arroz-carolino"
      ]
    },
    {
      "text": "Aqueça o leite à parte e junte-o ao arroz aos poucos, mexendo sempre.",
      "durationMinutes": 20,
      "ingredientRefs": [
        "leite"
      ]
    },
    {
      "text": "Junte o açúcar e a manteiga e continue a mexer até o arroz ficar cremoso.",
      "durationMinutes": 6,
      "ingredientRefs": [
        "acucar",
        "manteiga"
      ]
    },
    {
      "text": "Retire a casca de limão e o pau de canela.",
      "ingredientRefs": [
        "limao",
        "pau-de-canela"
      ]
    },
    {
      "text": "Bata as gemas numa taça e junte-lhes duas colheres do arroz quente, para temperar.",
      "ingredientRefs": [
        "ovo"
      ]
    },
    {
      "text": "Fora do lume, envolva as gemas no arroz. Nunca deixe voltar a ferver ou talha.",
      "ingredientRefs": [
        "ovo"
      ]
    },
    {
      "text": "Distribua por travessas e deixe arrefecer completamente.",
      "durationMinutes": 120,
      "passive": true
    },
    {
      "text": "Polvilhe com canela em pó antes de servir.",
      "ingredientRefs": [
        "canela-em-po"
      ]
    }
  ],
