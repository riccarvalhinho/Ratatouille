  "steps": [
    {
      "title": "Selar a carne",
      "text": "Carne em azeite bem quente, a desfazer com a colher, até perder a água e tostar.",
      "durationMinutes": 10,
      "ingredientRefs": [
        "carne-picada-de-vaca",
        "azeite",
        "sal",
        "pimenta-preta"
      ]
    },
    {
      "title": "Tostar as especiarias e apurar",
      "text": "Cebola, alho e malagueta a amolecer, cominhos e colorau meio minuto no fundo, depois a água até secar quase toda.",
      "durationMinutes": 12,
      "ingredientRefs": [
