        "dente-de-alho",
        "malagueta",
        "cominhos",
        "colorau",
        "agua"
      ]
    },
    {
      "title": "Fazer o guacamole",
      "text": "Abacate esmagado com o garfo, sumo de uma lima, sal e coentros picados.",
      "durationMinutes": 6,
      "ingredientRefs": [
        "abacate",
        "lima",
        "coentros"
      ]
    },
    {
      "title": "Preparar o tomate",
      "text": "Tomate em cubos com a cebola roxa picada, coentros, sal e o resto da lima.",
      "durationMinutes": 6,
      "ingredientRefs": [
        "tomate",
        "cebola-roxa"
      ]
    },
    {
      "title": "Aquecer as tortilhas",
      "text": "Frigideira seca, meio minuto de cada lado, empilhadas num pano. Montar à mesa.",
      "durationMinutes": 6,
