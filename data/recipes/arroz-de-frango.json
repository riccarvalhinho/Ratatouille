  "steps": [
    {
      "text": "Tempere as coxas de frango com sal e pimenta.",
      "ingredientRefs": [
        "coxa-de-frango",
        "sal",
        "pimenta-preta"
      ]
    },
    {
      "text": "Aloure o frango no azeite, de todos os lados. Retire e reserve.",
      "durationMinutes": 8,
      "ingredientRefs": [
        "coxa-de-frango",
        "azeite"
      ]
    },
    {
      "text": "No mesmo tacho, refogue a cebola, o alho e o louro.",
      "durationMinutes": 5,
      "ingredientRefs": [
        "cebola",
        "dente-de-alho",
        "folha-de-louro"
      ]
    },
    {
      "text": "Junte o tomate e deixe apurar até desfazer.",
      "durationMinutes": 5,
      "ingredientRefs": [
        "tomate"
      ]
    },
    {
      "text": "Refresque com o vinho branco e deixe evaporar o álcool.",
      "durationMinutes": 2,
      "ingredientRefs": [
        "vinho-branco"
      ]
    },
    {
      "text": "Volte a pôr o frango no tacho, junte a cenoura e a água. Tempere.",
      "ingredientRefs": [
        "coxa-de-frango",
        "cenoura",
        "agua",
        "sal"
      ]
    },
    {
      "text": "Deixe cozer tapado até o frango estar tenro.",
      "durationMinutes": 20,
      "ingredientRefs": [
        "coxa-de-frango"
      ],
      "passive": true
    },
    {
      "text": "Junte o arroz e as ervilhas. Mexa uma vez.",
      "ingredientRefs": [
        "arroz-carolino",
        "ervilhas-congeladas"
      ]
    },
    {
      "text": "Coza destapado até o arroz estar pronto e o caldo malandro.",
      "durationMinutes": 14,
      "ingredientRefs": [
        "arroz-carolino"
      ]
    },
    {
      "text": "Retifique o sal, polvilhe com salsa e sirva de imediato.",
      "ingredientRefs": [
        "salsa",
        "sal"
      ]
    }
  ],
