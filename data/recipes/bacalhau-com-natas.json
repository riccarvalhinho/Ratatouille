  "steps": [
    {
      "text": "Coza o bacalhau demolhado em água a ferver e desligue o lume.",
      "durationMinutes": 10,
      "ingredientRefs": [
        "bacalhau-salgado"
      ]
    },
    {
      "text": "Escorra, retire peles e espinhas e desfie o bacalhau em lascas.",
      "ingredientRefs": [
        "bacalhau-salgado"
      ]
    },
    {
      "text": "Frite as batatas em palitos até ficarem douradas mas ainda macias. Escorra em papel.",
      "durationMinutes": 10,
      "ingredientRefs": [
        "batata"
      ]
    },
    {
      "text": "Aloure a cebola e o alho no azeite até ficarem translúcidos.",
      "durationMinutes": 8,
      "ingredientRefs": [
        "cebola",
        "dente-de-alho",
        "azeite"
      ]
    },
    {
      "text": "Junte o bacalhau à cebola e envolva. Reserve.",
      "ingredientRefs": [
        "bacalhau-salgado"
      ]
    },
    {
      "text": "Para o béchamel: derreta a manteiga, junte a farinha e mexa até formar uma pasta.",
      "durationMinutes": 2,
      "ingredientRefs": [
        "manteiga",
        "farinha-de-trigo"
      ]
    },
    {
      "text": "Adicione o leite aos poucos, sempre a mexer, até engrossar.",
      "durationMinutes": 6,
      "ingredientRefs": [
        "leite"
      ]
    },
    {
      "text": "Tempere o béchamel com sal, pimenta e noz-moscada.",
      "ingredientRefs": [
        "sal",
        "pimenta-preta",
        "noz-moscada"
      ]
    },
    {
      "text": "Envolva as natas no béchamel.",
      "ingredientRefs": [
        "natas"
      ]
    },
    {
      "text": "Num pirex, misture as batatas, o bacalhau e metade do molho.",
      "ingredientRefs": [
        "batata",
        "bacalhau-salgado"
      ]
    },
    {
      "text": "Cubra com o restante molho e polvilhe com o queijo ralado.",
      "ingredientRefs": [
        "queijo-ralado"
      ]
    },
    {
      "text": "Leve ao forno a 200 °C até gratinar.",
      "durationMinutes": 25,
      "temperatureC": 200
    }
  ],
