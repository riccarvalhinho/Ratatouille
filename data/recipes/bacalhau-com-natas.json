  "steps": [
    {
      "title": "Cozer e desfiar o bacalhau",
      "text": "Em água a ferver, depois escorrer, tirar peles e espinhas e desfiar em lascas.",
      "durationMinutes": 10,
      "ingredientRefs": [
        "bacalhau-salgado"
      ]
    },
    {
      "title": "Fritar as batatas",
      "text": "Em palitos, até douradas mas ainda macias por dentro. Escorrer em papel.",
      "durationMinutes": 10,
      "ingredientRefs": [
        "batata"
      ]
    },
    {
      "title": "Refogar a cebola com o bacalhau",
      "text": "Alourar a cebola e o alho no azeite até ficarem translúcidos, juntar o bacalhau e envolver. Reservar.",
      "durationMinutes": 8,
      "ingredientRefs": [
        "cebola",
        "dente-de-alho",
        "azeite",
        "bacalhau-salgado"
      ]
    },
    {
      "title": "Fazer o roux",
      "text": "Derreter a manteiga, juntar a farinha e mexer até formar uma pasta.",
      "durationMinutes": 2,
      "ingredientRefs": [
        "manteiga",
        "farinha-de-trigo"
      ]
    },
    {
      "title": "Engrossar o molho",
      "text": "Leite aos poucos, sempre a mexer. Temperar com sal, pimenta e noz-moscada e envolver as natas.",
      "durationMinutes": 6,
      "ingredientRefs": [
        "leite",
        "sal",
        "pimenta-preta",
        "noz-moscada",
        "natas"
      ]
    },
    {
      "title": "Montar no pirex",
      "text": "Misturar as batatas, o bacalhau e metade do molho. Cobrir com o restante e polvilhar com o queijo.",
      "ingredientRefs": [
        "batata",
        "bacalhau-salgado",
        "queijo-ralado"
      ]
    },
    {
      "title": "Gratinar",
      "text": "No forno, até a superfície ficar dourada.",
      "durationMinutes": 25,
      "temperatureC": 200
    }
  ],
